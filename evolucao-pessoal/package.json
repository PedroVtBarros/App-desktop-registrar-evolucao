{
  "name": "evolucao-pessoal",
  "version": "1.0.0",
  "description": "Hábitos, habilidades e evolução pessoal — app desktop local e offline",
  "author": "Evolução Pessoal",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir --win --x64",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "br.com.evolucaopessoal.app",
    "productName": "Evolução Pessoal",
    "copyright": "Evolução Pessoal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/build/**",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/linux*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Evolucao-Pessoal-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Evolução Pessoal",
      "deleteAppDataOnUninstall": false,
      "language": "1046"
    }
  }
}
